@page
@model IndexModel
@{
    Layout = null;
    ViewData["Title"] = "MyReader";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>MyReader</title>

    <link rel="stylesheet"
          href="~/css/Reader.css"
          asp-append-version="true" />
</head>

<body>
    <main id="app">

        <section id="uploadSection">

            <h1>Welcome to MY Reader :)</h1>

            <form id="uploadForm">

                @Html.AntiForgeryToken()

                <label for="fileInput">
                    Select a file to upload:
                </label>

                <input type="file"
                       id="fileInput"
                       name="uploadedFile"
                       accept=".pdf,.txt,.docx,.epub,.xlsx"
                       required />

                <button type="submit">
                    Upload
                </button>

            </form>

            <div id="errorMessage" role="alert" hidden></div>

        </section>

        <section id="readingSection" hidden>

            <header id="readerTopBar">
                <a href="/"
                   id="homeButton"
                   aria-label="Home"
                   title="Home">
                    <svg viewBox="0 0 24 24"
                         width="20"
                         height="20"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="m3 10 9-7 9 7" />
                        <path d="M5 9v12h14V9" />
                        <path d="M9 21v-7h6v7" />
                    </svg>
                </a>
            </header>

            <div id="pagesContainer"></div>

            <pre id="textContainer" hidden></pre>

            <article id="docxContainer" hidden></article>

            <div id="epubContainer" hidden></div>

            <div id="xlsxContainer" hidden></div>

            <div id="epubControls" hidden>

                <button type="button"
                        id="epubPrev"
                        aria-label="Previous page">
                    &#10094;
                </button>

                <button type="button"
                        id="epubNext"
                        aria-label="Next page">
                    &#10095;
                </button>

            </div>

        </section>

        <div id="dropOverlay" hidden>
            <div id="dropMessage">
                <svg viewBox="0 0 24 24"
                     width="48"
                     height="48"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.5"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M12 16V4" />
                    <path d="m7 9 5-5 5 5" />
                    <path d="M20 16.5v2A2.5 2.5 0 0 1 17.5 21h-11A2.5 2.5 0 0 1 4 18.5v-2" />
                </svg>

                <h2>Drop your file here</h2>
                <p>Release to open your document</p>
            </div>
        </div>

    </main>

    <script src="~/lib/mammoth/mammoth.browser.min.js"></script>
    <script src="~/lib/dompurify/purify.min.js"></script>
    <script src="~/lib/jszip/jszip.min.js"></script>
    <script src="~/lib/epub/epub.min.js"></script>
    <script src="~/lib/xlsxjs/xlsx.full.min.js"></script>

    <script type="module"
            src="~/js/Reader.js"
            asp-append-version="true">
    </script>

</body>
</html>
